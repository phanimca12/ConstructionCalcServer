[Unit]
Description=Schema Service Application
[Service]
User=root
# The configuration file application.properties should be here:

#change this to your workspace
WorkingDirectory=/opt/dst/schema-services/schemaservice

EnvironmentFile=/etc/environment

Environment="LOG_FILE_PATH=/opt/dst/schema-services/schemaservice/logs/schemaservice.log"
Environment="JDBC_URL=jdbc:oracle:thin:@localhost:1521/AWD1"
Environment="USERNAME=SCHMDB"
Environment="PASSWORD=password"
Environment="DB_NAME=oracle"

#executable is a bash script which calls jar file
ExecStart=/bin/bash /opt/dst/schema-services/schemaservice/run.sh

SuccessExitStatus=0
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
