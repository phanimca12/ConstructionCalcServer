<?xml version="1.0" encoding="UTF-8"?>
<assembly
        xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
    http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2
      http://maven.apache.org/xsd/assembly-1.1.2.xsd"
>
    <id>schemaservice</id>
    <formats>
        <format>zip</format>
        <format>tar.gz</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>schemaservice</baseDirectory>
    <files>
        <file>
            <source> ${project.build.directory}/${project.artifactId}-${project.version}.jar</source>
            <outputDirectory>/</outputDirectory>
        </file>
        <file>
            <source> ${basedir}/cmd/run.sh</source>
            <outputDirectory>/</outputDirectory>
        </file>
        <file>
            <source> ${basedir}/cmd/schemaService.service</source>
            <outputDirectory>/</outputDirectory>
        </file>
        <file>
            <source> ${basedir}/cmd/schemaService.exe</source>
            <outputDirectory>/</outputDirectory>
        </file>
        <file>
            <source> ${basedir}/cmd/schemaService.xml</source>
            <outputDirectory>/</outputDirectory>
        </file>
        <file>
            <source> ${basedir}/src/main/resources/application-prod.yml</source>
            <outputDirectory>/</outputDirectory>
            <destName>application.yml</destName>
        </file>
    </files>

</assembly>